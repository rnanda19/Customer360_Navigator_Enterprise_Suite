# Customer360 Navigator Enterprise Suite - environment variables
# Copy to .env (gitignored) and fill in your own values. Every variable below is a REAL variable
# actually read by this codebase (grep-verified against src/) - nothing here is illustrative.

# Required to run ANY of the 7 FastAPI services (src/services/*.py). Real API-key auth
# (src/services/service_auth.py) - a service with this unset refuses every protected request
# with 503 rather than serving it unauthenticated. / and /health stay open with no key; every
# other endpoint needs an X-API-Key header matching this value. Generate a real random value
# for anything beyond local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
C360_API_KEY=

# Optional. Overrides the automatic upward-walk project-root resolver
# (see src/utils/performance_setup.py::resolve_project_root()). Only needed if a notebook or
# service is launched from a working directory where the automatic walk can't find both
# configs/ and src/ - most local runs never need to set this.
# C360_PROJECT_ROOT=/absolute/path/to/Customer360_Navigator_Enterprise_Suite

# Required only to run BP6 (GenAI Resolution Assistant) for real - either its notebook's Gate 5
# cell or its FastAPI service (src/services/bp6_resolution_service.py, port 8006). Every real
# /resolve call using this key makes a live, paid-quota-consuming call to the Google Gemini API.
# Never commit a real key - this file is a template only.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash in code if unset (see
# src/services/bp6_resolution_service.py). Set this if Google retires that model tier again, the
# way gemini-2.5-flash was retired mid-project (see reports/bp6_genai_resolution_assistant/CHANGELOG.md).
# GEMINI_MODEL=gemini-3.6-flash

# Optional. BP7's GET /version endpoint (production-hardening addition, 2026-09-26) reports this
# as the real git commit it is running - a built Docker image has no .git directory (see
# src/services/docker/bp7_decision_engine_service/Dockerfile), so without this set, /version
# honestly reports git_commit: null rather than guessing. Set it at deploy time to the commit
# you're actually deploying, e.g.: C360_GIT_COMMIT=$(git rev-parse --short HEAD)
# C360_GIT_COMMIT=

# Optional. Caps requests/minute on BP7's in-memory, per-process rate limiter (production-
# hardening addition, 2026-09-26) - keyed by X-API-Key or client IP, exempts / and /health.
# Defaults to 120 if unset; 0 disables it. See RENDER_DEPLOYMENT.md for why an in-memory limiter
# is an honest fit for BP7's single-instance free-tier deployment.
# C360_RATE_LIMIT_PER_MINUTE=120

# Optional. Seconds between periodic background refreshes of BP7's live self-test gauges
# (bp7_self_test_last_result / bp7_self_test_last_run_timestamp_seconds on GET /metrics/prometheus
# - Priority 3 observability addition, 2026-09-26). Defaults to 300 (5 minutes) if unset; 0
# disables the background refresh entirely (the gauges are then only updated by a real client
# calling GET /decide/self-test). See MONITORING.md for the full disclosure on which metrics are
# live vs. static-per-restart.
# C360_SELF_TEST_METRICS_INTERVAL_SECONDS=300
