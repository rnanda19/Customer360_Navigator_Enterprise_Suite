# Customer360 Navigator - BP5 driver-report service Dockerfile.dockerignore
# Build context is the project ROOT (see this directory's Dockerfile header). Named
# `Dockerfile.dockerignore` (not `.dockerignore`) so BuildKit applies it to THIS Dockerfile only -
# same empirically-verified naming as bp1's/bp2's/bp3's/bp4's/bp6's, since this project has
# multiple Dockerfiles sharing one build context and a plain root `.dockerignore` would apply to
# all of them indiscriminately.

# Data - never belongs in a served image
data/
**/*.csv

# BP5's own image serves ONLY its own real Gate 5/Gate 7 JSON artifacts (see Dockerfile's explicit
# COPY of those three real files) - every other real artifact anywhere else in the tree is excluded.
notebooks/
!notebooks/bp5_root_cause_driver_analytics/artifacts/gate5_prioritized_root_cause_report_outcome_1_intervention_required.json
!notebooks/bp5_root_cause_driver_analytics/artifacts/gate5_prioritized_root_cause_report_outcome_2_timely_response_failure.json
!notebooks/bp5_root_cause_driver_analytics/artifacts/executive_rollup_manifest.json
**/*.ipynb
**/*.ipynb_checkpoints/

# BP5 fits no model and persists nothing to models/ (no Hardening Step 2 for BP5 - see Dockerfile
# header) - this image needs nothing from models/ at all.
models/

# Docs, reports, packaging staging, logs - not needed to serve
docs/
reports/
github_repo/
kaggle/
linkedin/
logs/
powerbi/

# Tests - the image serves the app, it does not run its own test suite
tests/

# VCS / editor / cache noise
.git/
.github/
.vscode/
**/__pycache__/
**/*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/

# This project's own doc/config files not needed at runtime
*.docx
README.md
LICENSE
LESSONS_LEARNED_APPLIED.md
desktop.ini
