# Customer360 Navigator - BP1 Customer Intent Classification inference service
# Hardening Step 5 (Docker packaging). Mirrors this project's own established one-service-
# one-container pattern (Hardening Step 3: one FastAPI app per problem, independently deployable).
#
# BUILD CONTEXT: the Customer360_Navigator_Enterprise_Suite project ROOT (not this directory) -
# this Dockerfile needs PROJECT_STRUCTURE_LOCKED.md, src/, and the REAL persisted model bundle
# from models/bp1_customer_intent_classification/, all of which live above this file:
#
#   docker build -f src/services/docker/bp1_inference_service/Dockerfile -t c360-bp1-service .
#
# REQUIRES Hardening Step 2 to have been run FOR REAL first: this build COPYs the real, already-
# persisted bp1_champion_pipeline.joblib from your own project tree (models/**/*.joblib is
# gitignored by design - never something baked in by Claude, always your own real run's output).
# If that file does not exist yet, this build fails at the COPY step with a clear "not found"
# error rather than silently shipping a model-less image - run
# notebooks/bp1_customer_intent_classification/bp1_customer_intent_classification_model_persistence.ipynb
# for real first.
#
# Dependencies below are the real, minimal runtime set for THIS service (grep-verified against
# src/models/model_persistence.py, src/services/service_common.py, and
# src/services/bp1_inference_service.py's actual imports, 2026-09-22) - deliberately NOT the full
# notebook-execution requirements.txt (no spacy/transformers/xgboost/catboost/matplotlib/etc. -
# BP1's real champion is a plain sklearn Pipeline, so none of those are needed to serve it).

# API-key auth added 2026-09-26 (src/services/service_auth.py, see SECURITY.md): this image's
# dependency list above is UNCHANGED - the new services.service_auth import needs only fastapi
# (already installed above), nothing new.

FROM python:3.11-slim

LABEL org.opencontainers.image.title="Customer360 Navigator - BP1 Inference Service"
LABEL org.opencontainers.image.description="Predicts a BANKING77 customer-intent class from raw complaint text."

WORKDIR /app

# Non-root service user, created before COPY so every file below can be chowned to it directly -
# never runs as root inside the container.
RUN useradd --no-create-home --uid 1000 c360service

# System deps: none beyond the base image - scikit-learn/scipy ship prebuilt wheels for this
# platform, so no compiler toolchain is needed here (keeps the image small, avoids a real class
# of "works in venv, breaks in Docker" bugs from a missing build-essential).
RUN pip install --no-cache-dir \
        "fastapi>=0.115" \
        "pydantic>=2.0" \
        "uvicorn>=0.30" \
        "joblib>=1.3" \
        "numpy>=1.26" \
        "pandas>=2.2" \
        "scikit-learn>=1.5" \
        "scipy>=1.13"

# The project-root marker: resolve_project_root() (src/services/service_common.py) walks upward
# from the process cwd looking for this file - never a hardcoded path (the real bug this pattern
# was built to avoid on a prior hardening pass, documented in service_common.py itself).
COPY --chown=c360service:c360service PROJECT_STRUCTURE_LOCKED.md ./PROJECT_STRUCTURE_LOCKED.md

# Only the real src/ subpackages this service actually imports (models, services, features) -
# features/ is BP2's, not BP1's, but src/ is one installable package (pyproject.toml,
# [tool.setuptools.packages.find] where=["src"]) so copying it whole keeps this Dockerfile honest
# about the package's real shape rather than hand-picking files that could silently drift out of
# sync with a future import added to either service.
COPY --chown=c360service:c360service src/ ./src/

# The REAL, already-persisted model bundle - see the header comment above. NOT generated by this
# build, NOT generated by Claude - this is your own real Hardening Step 2 output.
COPY --chown=c360service:c360service models/bp1_customer_intent_classification/bp1_champion_pipeline.joblib \
     ./models/bp1_customer_intent_classification/bp1_champion_pipeline.joblib
COPY --chown=c360service:c360service models/bp1_customer_intent_classification/bp1_model_metadata.json \
     ./models/bp1_customer_intent_classification/bp1_model_metadata.json

ENV C360_PROJECT_ROOT=/app
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

USER c360service

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=3).status == 200 else 1)"

CMD ["uvicorn", "services.bp1_inference_service:app", "--host", "0.0.0.0", "--port", "8001"]
