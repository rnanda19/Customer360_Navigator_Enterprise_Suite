{
  "id": null,
  "uid": "c360-bp7-production-monitor",
  "title": "Customer360 Navigator - BP7 Production Monitor",
  "description": "Real Prometheus metrics scraped from BP7's GET /metrics/prometheus. See MONITORING.md at the repo root: panels under 'Service Health & Availability', 'Live Governance Signal', 'Resource Usage & Process', and 'Request Rate & Latency Over Time' are live/per-request; panels under 'Static Gate 5 Population Governance' are the real, already-computed Gate 5 numbers, refreshed once per service restart - never live per-request drift detection.",
  "tags": [
    "customer360",
    "bp7",
    "production"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service Health & Availability (live, per-request)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API Availability (24h)",
      "description": "Real Prometheus `up` gauge (1 if the last scrape of this target succeeded) averaged over 24h.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "c360_prometheus"
      },
      "targets": [
        {
          "expr": "avg_over_time(up{job=~\"bp7.*\"}[24h]) * 100",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "c360_prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 Latency",
      "description": "Real p95 request latency across all routes, last 5 minutes, from bp7_http_request_duration_seconds.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "c360_prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(bp7_http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "c360_prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 250
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests (1h)",
      "description": "Real total requests served across all routes in the last hour.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "c360_prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(bp7_http_requests_total[1h]))",
