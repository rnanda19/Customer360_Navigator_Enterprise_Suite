    {
      "id": 7,
      "type": "stat",
      "title": "Self-Test Status (live)",
      "description": "Real internal-consistency check (GET /decide/self-test), client-triggered and/or periodically background-refreshed. Live, never static.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "c360_prometheus"
      },
      "targets": [
        {
          "expr": "bp7_self_test_last_result",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "c360_prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "PASS",
                  "color": "green"
                },
                "0": {
                  "text": "FAIL",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
