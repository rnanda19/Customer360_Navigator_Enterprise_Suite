# Raw / processed data - never committed (Quality Gates, zero-fabrication + compliance)
data/raw/**
data/processed/**
data/external/**
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Models / large artifacts
models/**/*.joblib
models/**/*.pkl
models/**/*.onnx
*.parquet

# Phase D MLOps: local MLflow tracking store + registry (sqlite + artifact files) - machine-local
# training/registration output, same rule already applied to models/**/*.joblib above. The real
# governance/audit JSONL logs under governance/ are NOT ignored - those are small, real,
# append-only evidence this project intentionally commits.
mlruns/

# Notebook checkpoints / caches
.ipynb_checkpoints/
**/__pycache__/
*.pyc

# Env / secrets
.env
*.pem
*.key
# Real Prometheus scrape config (Priority 3 observability addition, 2026-09-26) - contains
# the real C360_API_KEY value in its http_headers block. Same .env.example -> .env convention;
# monitoring/prometheus/prometheus.yml.example is the committed template.
monitoring/prometheus/prometheus.yml

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
logs/**
!logs/.gitkeep

# Power BI local cache
powerbi/**/*.pbix.bak
